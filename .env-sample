# Copy to .env (never commit .env). Local development values only.
POSTGRES_DB=halcyon
POSTGRES_USER=halcyon
POSTGRES_PASSWORD=change-me
# Host port; 5433 so it does not clash with a PostgreSQL already on 5432.
POSTGRES_PORT=5433

# The one shared password agents sign in with (not production).
AGENT_PASSWORD=change-me

# Demo: the sign-in page signs in as this agent with one click, no password. Empty switches the button off.
DEFAULT_AGENT_EMAIL=anna.nowak@company.io

# Host port of the app with `docker compose --profile app up`.
APP_PORT=8080

# Object storage for attachments (RustFS, S3 API). Local keys only; the console is on S3_CONSOLE_PORT.
S3_ACCESS_KEY=halcyon
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=halcyon-attachments
S3_PORT=9010
S3_CONSOLE_PORT=9011

# HTTP answers and the application's log kept in the database (ADR-0011). TimeSpan: "14.00:00:00" = 14 days.
#MONITORING_RETENTION=14.00:00:00
#MONITORING_CLEANUP_INTERVAL=01:00:00
# Lowest level stored: Verbose, Debug, Information, Warning, Error, Fatal.
#MONITORING_LOG_LEVEL=Information

# SLA windows in hours (ADR-0013). A changed value moves only tickets reported or re-prioritised after it.
#SLA_CRITICAL_HOURS=3
#SLA_HIGH_HOURS=8
#SLA_MEDIUM_HOURS=72
#SLA_LOW_HOURS=168

# Mail (spec 013). compose sends to Mailpit (UI on MAILPIT_UI_PORT); the deadline warnings for tickets nobody has taken
# go to MAIL_POOL_ADDRESS when it is set.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
#MAIL_FROM_ADDRESS=halcyon@company.io
#MAIL_POOL_ADDRESS=zespol@company.io
