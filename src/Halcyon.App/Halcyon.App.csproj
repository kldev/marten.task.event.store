<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The one host: Blazor (Interactive Server) with the features inside it (ADR-0001). -->
  <PropertyGroup>
    <RootNamespace>Halcyon.App</RootNamespace>
    <UserSecretsId>halcyon-app-4e1b2c</UserSecretsId>
    <!-- The SDK infers this from .razor Content items, which do not exist when the Dockerfile restores from the
         .csproj alone: the framework assets package (blazor.web.js) would then be missing from the image. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Halcyon.Database/Halcyon.Database.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Halcyon.IntegrationTests" />
    <InternalsVisibleTo Include="Halcyon.E2E" />
  </ItemGroup>

  <!-- Tailwind CSS: rebuilds wwwroot/css/app.css (committed) when the styles or the markup change. Runs only where
       `npm install` was done in this folder; images and CI use the committed file (SkipTailwind=true to force). -->
  <ItemGroup>
    <TailwindInput Include="Styles/app.css;Components/**/*.razor" />
  </ItemGroup>
  <Target
    Name="TailwindBuild"
    BeforeTargets="BeforeBuild"
    Condition="'$(SkipTailwind)' != 'true' And Exists('node_modules/.bin/tailwindcss')"
    Inputs="@(TailwindInput)"
    Outputs="wwwroot/css/app.css"
  >
    <Exec Command="npm run build:css --silent" />
  </Target>
</Project>
