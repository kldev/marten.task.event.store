@* The "all / only open / only resolved" toggle of the lists and the reports: three segments, one pressed. *@
<div>
    <span class="label text-xs" id="@(TestId)-label">Realizacja</span>
    <div class="inline-flex rounded-lg border border-ink-200 bg-white p-0.5" role="radiogroup" aria-labelledby="@(TestId)-label" data-testid="@TestId">
        @foreach (var (value, text) in Options)
        {
            var chosen = Value == value;
            <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")"
                    class="rounded-md px-3 py-1 text-sm transition @(chosen ? "bg-halcyon-700 font-medium text-white shadow-sm" : "text-ink-600 hover:bg-ink-50")"
                    data-testid="@(TestId)-@value.ToString().ToLowerInvariant()" @onclick="() => ChooseAsync(value)">
                @text
            </button>
        }
    </div>
</div>

@code {
    private static readonly (CompletionFilter Value, string Text)[] Options =
    [
        (CompletionFilter.Any, "Wszystkie"),
        (CompletionFilter.Open, "Niezrealizowane"),
        (CompletionFilter.Done, "Zrealizowane"),
    ];

    [Parameter]
    public CompletionFilter Value { get; set; }

    [Parameter]
    public EventCallback<CompletionFilter> ValueChanged { get; set; }

    [Parameter]
    public string TestId { get; set; } = "filter-completion";

    private async Task ChooseAsync(CompletionFilter value)
    {
        if (value == Value)
            return;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
