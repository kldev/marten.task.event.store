@* The custom date and time picker (spec 006). The value is an instant (UTC); the calendar and the clock are in Warsaw
   time. Days outside [Min, Max] are disabled; a time later than Max on Max's day is clamped to Max. *@
@inherits InputBase<DateTimeOffset?>

<div class="relative" data-testid="@TestId">
    <button type="button" id="@Id" @ref="fieldRef"
            class="input flex items-center justify-between gap-2 text-left @CssClass"
            aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")"
            data-testid="@(TestId)-field" @onclick="ToggleAsync">
        <span class="@(CurrentValue is null ? "text-ink-400" : "font-mono text-ink-900")" data-testid="@(TestId)-value">
            @(CurrentValue is { } value ? LocalTime.Format(value) : "dd.mm.rrrr gg:mm")
        </span>
        <Icon Name="calendar" Class="size-4 text-ink-400" />
    </button>

    @if (open)
    {
        <div role="dialog" aria-modal="false" aria-label="Wybór daty i godziny" data-testid="@(TestId)-popup"
             class="card absolute left-0 z-30 mt-2 w-[19rem] p-3 shadow-lg" @onkeydown="OnKeyDownAsync">
            <div class="mb-2 flex items-center justify-between">
                <button type="button" class="btn btn-ghost btn-sm" aria-label="Poprzedni miesiąc"
                        data-testid="@(TestId)-prev" @onclick="PreviousMonth" disabled="@(!CanGoBack)">
                    <Icon Name="chevron-left" />
                </button>
                <span class="text-sm font-semibold text-ink-800" aria-live="polite" data-testid="@(TestId)-month">@month.Title</span>
                <button type="button" class="btn btn-ghost btn-sm" aria-label="Następny miesiąc"
                        data-testid="@(TestId)-next" @onclick="NextMonth" disabled="@(!CanGoForward)">
                    <Icon Name="chevron-right" />
                </button>
            </div>

            <div role="grid" tabindex="0" @ref="gridRef" aria-label="@month.Title" data-testid="@(TestId)-grid"
                 class="rounded-lg focus-visible:outline-2">
                <div role="row" class="grid grid-cols-7 text-center text-[11px] font-semibold text-ink-400 uppercase">
                    @foreach (var name in CalendarMonth.WeekdayShortNames)
                    {
                        <span role="columnheader" class="py-1">@name</span>
                    }
                </div>
                @foreach (var week in month.Weeks)
                {
                    <div role="row" class="grid grid-cols-7 gap-0.5">
                        @foreach (var day in week)
                        {
                            var isSelected = SelectedDate == day.Date;
                            var isFocused = focusedDate == day.Date;
                            var isToday = Today == day.Date;
                            <button type="button" role="gridcell" tabindex="-1"
                                    data-date="@day.Date.ToString("yyyy-MM-dd")"
                                    aria-selected="@(isSelected ? "true" : "false")"
                                    aria-disabled="@(day.Disabled ? "true" : "false")"
                                    disabled="@day.Disabled"
                                    class="@DayClass(day, isSelected, isFocused, isToday)"
                                    @onclick="() => PickDay(day)">
                                @day.Date.Day
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="mt-3 flex items-center gap-2 border-t border-ink-100 pt-3">
                <Icon Name="clock" Class="size-4 text-ink-400" />
                <label class="sr-only" for="@(Id)-hour">Godzina</label>
                <select id="@(Id)-hour" class="input w-auto py-1 font-mono" data-testid="@(TestId)-hour"
                        value="@hour" @onchange="OnHourChanged">
                    @for (var h = 0; h < 24; h++)
                    {
                        <option value="@h">@h.ToString("00")</option>
                    }
                </select>
                <span class="font-mono text-ink-500">:</span>
                <label class="sr-only" for="@(Id)-minute">Minuta</label>
                <select id="@(Id)-minute" class="input w-auto py-1 font-mono" data-testid="@(TestId)-minute"
                        value="@minute" @onchange="OnMinuteChanged">
                    @for (var m = 0; m < 60; m++)
                    {
                        <option value="@m">@m.ToString("00")</option>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(hint))
            {
                <p class="mt-2 text-xs text-amber-800" data-testid="@(TestId)-hint">@hint</p>
            }

            <div class="mt-3 flex justify-between">
                <button type="button" class="btn btn-secondary btn-sm" data-testid="@(TestId)-now" @onclick="PickNow">Teraz</button>
                <button type="button" class="btn btn-primary btn-sm" data-testid="@(TestId)-done" @onclick="CloseAsync">Gotowe</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public DateTimeOffset? Min { get; set; }

    [Parameter]
    public DateTimeOffset? Max { get; set; }

    [Parameter]
    public string Id { get; set; } = "date-time";

    [Parameter]
    public string TestId { get; set; } = "picker";

    [Inject]
    private TimeProvider Time { get; set; } = null!;

    private ElementReference fieldRef;
    private ElementReference gridRef;
    private bool open;
    private bool focusGrid;
    private CalendarMonth month = CalendarMonth.Build(2000, 1);
    private DateOnly focusedDate;
    private int hour;
    private int minute;
    private string? hint;

    private DateOnly Today => DateOnly.FromDateTime(LocalTime.ToLocal(Time.GetUtcNow()).DateTime);
    private DateOnly? MinDate => Min is { } min ? DateOnly.FromDateTime(LocalTime.ToLocal(min).DateTime) : null;
    private DateOnly? MaxDate => Max is { } max ? DateOnly.FromDateTime(LocalTime.ToLocal(max).DateTime) : null;
    private DateOnly? SelectedDate => CurrentValue is { } v ? DateOnly.FromDateTime(LocalTime.ToLocal(v).DateTime) : null;

    private bool CanGoBack => MinDate is not { } min || new DateOnly(month.Year, month.Month, 1) > min;
    private bool CanGoForward =>
        MaxDate is not { } max || new DateOnly(month.Year, month.Month, 1).AddMonths(1) <= max;

    private async Task ToggleAsync()
    {
        if (open)
        {
            await CloseAsync();
            return;
        }

        var local = LocalTime.ToLocal(CurrentValue ?? Time.GetUtcNow());
        hour = local.Hour;
        minute = local.Minute;
        focusedDate = DateOnly.FromDateTime(local.DateTime);
        hint = null;
        ShowMonth(focusedDate.Year, focusedDate.Month);
        open = true;
        focusGrid = true;
    }

    private async Task CloseAsync()
    {
        open = false;
        await Task.Yield();
        await fieldRef.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusGrid && open)
        {
            focusGrid = false;
            await gridRef.FocusAsync();
        }
    }

    private void ShowMonth(int year, int monthNumber) => month = CalendarMonth.Build(year, monthNumber, MinDate, MaxDate);

    private void PreviousMonth()
    {
        var (y, m) = month.Previous;
        ShowMonth(y, m);
    }

    private void NextMonth()
    {
        var (y, m) = month.Next;
        ShowMonth(y, m);
    }

    private void PickDay(CalendarDay day)
    {
        if (day.Disabled)
            return;
        focusedDate = day.Date;
        if (day.Date.Month != month.Month || day.Date.Year != month.Year)
            ShowMonth(day.Date.Year, day.Date.Month);
        Commit(day.Date);
    }

    private void PickNow()
    {
        var local = LocalTime.ToLocal(Time.GetUtcNow());
        hour = local.Hour;
        minute = local.Minute;
        focusedDate = DateOnly.FromDateTime(local.DateTime);
        ShowMonth(focusedDate.Year, focusedDate.Month);
        Commit(focusedDate);
    }

    private void OnHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var h))
            hour = h;
        Commit(SelectedDate ?? focusedDate);
    }

    private void OnMinuteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
            minute = m;
        Commit(SelectedDate ?? focusedDate);
    }

    /// <summary>Date + the chosen hour and minute, as an instant; clamped into [Min, Max].</summary>
    private void Commit(DateOnly date)
    {
        hint = null;
        var value = LocalTime.FromLocal(date.ToDateTime(new TimeOnly(hour, minute)));
        if (Max is { } max && value > max)
        {
            value = TruncateToMinute(max);
            var local = LocalTime.ToLocal(value);
            hour = local.Hour;
            minute = local.Minute;
            hint = "Data zgłoszenia nie może być w przyszłości - ustawiono najpóźniejszą możliwą.";
        }
        if (Min is { } min && value < min)
        {
            value = TruncateToMinute(min).AddMinutes(1);
            var local = LocalTime.ToLocal(value);
            hour = local.Hour;
            minute = local.Minute;
            hint = "Ustawiono najwcześniejszą możliwą datę.";
        }
        CurrentValue = value;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                await CloseAsync();
                return;
            case "ArrowLeft":
                MoveFocus(-1);
                break;
            case "ArrowRight":
                MoveFocus(1);
                break;
            case "ArrowUp":
                MoveFocus(-7);
                break;
            case "ArrowDown":
                MoveFocus(7);
                break;
            case "Enter":
                var day = month.Days.FirstOrDefault(d => d.Date == focusedDate);
                if (day is not null)
                    PickDay(day);
                break;
        }
    }

    private void MoveFocus(int days)
    {
        var next = focusedDate.AddDays(days);
        if ((MinDate is { } min && next < min) || (MaxDate is { } max && next > max))
            return;
        focusedDate = next;
        if (next.Month != month.Month || next.Year != month.Year)
            ShowMonth(next.Year, next.Month);
    }

    private static DateTimeOffset TruncateToMinute(DateTimeOffset v) =>
        new(v.Year, v.Month, v.Day, v.Hour, v.Minute, 0, v.Offset);

    private static string DayClass(CalendarDay day, bool selected, bool focused, bool today)
    {
        var classes = "h-9 rounded-md text-sm tabular-nums transition-colors ";
        if (day.Disabled)
            return classes + "cursor-not-allowed text-ink-300 line-through decoration-ink-200";
        if (selected)
            classes += "bg-halcyon-700 font-semibold text-white ";
        else if (!day.InMonth)
            classes += "text-ink-400 hover:bg-ink-100 ";
        else
            classes += "text-ink-800 hover:bg-halcyon-50 ";
        if (today && !selected)
            classes += "font-semibold text-rufous-600 ";
        if (focused)
            classes += "ring-2 ring-halcyon-400 ";
        return classes;
    }

    protected override bool TryParseValueFromString(
        string? value,
        out DateTimeOffset? result,
        [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage
    )
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }
        if (
            DateTime.TryParseExact(
                value,
                "dd.MM.yyyy HH:mm",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None,
                out var parsed
            )
        )
        {
            result = LocalTime.FromLocal(parsed);
            validationErrorMessage = null;
            return true;
        }
        result = null;
        validationErrorMessage = "Podaj datę w formacie dd.mm.rrrr gg:mm.";
        return false;
    }
}
