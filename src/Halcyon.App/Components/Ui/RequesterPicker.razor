@* Who the ticket is from (spec 002): a person from the list (searchable) xor incognito. *@
<fieldset class="space-y-3" data-testid="requester">
    <legend class="label">@T("Zgłaszający", "Requester")</legend>

    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-700">
        <input type="checkbox" class="size-4 rounded border-ink-300 text-halcyon-700" data-testid="requester-incognito"
               checked="@Incognito" @onchange="OnIncognitoChanged" />
        <Icon Name="eye-off" Class="size-4 text-ink-400" />
        @T("Incognito - bez danych zgłaszającego", "Incognito - without the requester's details")
    </label>

    @if (!Incognito)
    {
        <div class="relative">
            <Icon Name="search" Class="pointer-events-none absolute top-2.5 left-3 size-4 text-ink-400" />
            <input type="search" class="input pl-9" placeholder="@T("Szukaj po imieniu, nazwisku lub dziale…", "Search by first name, last name or department…")"
                   aria-label="@T("Szukaj zgłaszającego", "Search for the requester")" data-testid="requester-search"
                   value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
        </div>
        <ul class="max-h-56 divide-y divide-ink-100 overflow-y-auto rounded-lg border border-ink-200 bg-white" role="listbox"
            aria-label="@T("Lista osób", "List of people")" data-testid="requester-list">
            @foreach (var person in Filtered)
            {
                var selected = person.Id == PersonId;
                <li role="option" aria-selected="@(selected ? "true" : "false")">
                    <button type="button" data-testid="requester-option" data-email="@person.Email"
                            class="flex w-full items-center justify-between gap-2 px-3 py-2 text-left text-sm @(selected ? "bg-halcyon-50 text-halcyon-900" : "hover:bg-ink-50")"
                            @onclick="() => SelectAsync(person.Id)">
                        <span>
                            <span class="font-medium">@person.FullName</span>
                            <span class="ml-1 text-xs text-ink-500">@N(person.Department)</span>
                        </span>
                        @if (selected)
                        {
                            <Icon Name="check" Class="size-4 text-halcyon-700" />
                        }
                    </button>
                </li>
            }
            @if (!Filtered.Any())
            {
                <li class="px-3 py-2 text-sm text-ink-500">@T("Nikogo nie znaleziono.", "No one found.")</li>
            }
        </ul>
        @if (Selected is { } chosen)
        {
            <p class="text-sm text-ink-600" data-testid="requester-selected">@T("Wybrano:", "Selected:") <strong>@chosen.FullName</strong></p>
        }
    }
</fieldset>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PersonRow> People { get; set; } = [];

    [Parameter]
    public Guid? PersonId { get; set; }

    [Parameter]
    public EventCallback<Guid?> PersonIdChanged { get; set; }

    [Parameter]
    public bool Incognito { get; set; }

    [Parameter]
    public EventCallback<bool> IncognitoChanged { get; set; }

    private string search = "";

    private PersonRow? Selected => People.FirstOrDefault(p => p.Id == PersonId);

    private IEnumerable<PersonRow> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? People
            : People.Where(p =>
                p.FullName.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
                || p.Department.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
                || N(p.Department).Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
            );

    private async Task SelectAsync(Guid id)
    {
        PersonId = id;
        await PersonIdChanged.InvokeAsync(id);
    }

    private async Task OnIncognitoChanged(ChangeEventArgs e)
    {
        Incognito = e.Value is true;
        await IncognitoChanged.InvokeAsync(Incognito);
        if (Incognito)
        {
            // Incognito never names a person: the switch clears the choice.
            PersonId = null;
            await PersonIdChanged.InvokeAsync(null);
        }
    }
}
