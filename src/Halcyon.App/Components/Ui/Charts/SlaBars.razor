@* How much of the SLA resolving a ticket takes, per priority (spec 009): the light bar is the 90th percentile, the dark
   one the median, the vertical line is 100 % of the SLA - past it the ticket was late. *@
@using Halcyon.Domain.Tickets
@using static Halcyon.App.Components.Ui.Charts.ChartScale

@if (Rows.All(r => r.Count == 0))
{
    <p class="py-6 text-center text-sm text-ink-500" data-testid="sla-chart-empty">@T("Nic nie zrealizowano w tym okresie.", "Nothing was resolved in this period.")</p>
}
else
{
    <div class="space-y-3" data-testid="sla-chart">
        <div class="grid grid-cols-[minmax(6rem,9rem)_1fr] gap-3 text-[11px] text-ink-500" aria-hidden="true">
            <span></span>
            <span class="relative h-3">
                @foreach (var tick in Ticks)
                {
                    <span class="absolute whitespace-nowrap tabular-nums @(tick == 0 ? "" : tick >= Max ? "-translate-x-full" : "-translate-x-1/2") @(tick == 1 ? "font-semibold text-ink-700" : "")" style="left: @Pos(tick)">@Percent(tick)</span>
                }
            </span>
        </div>
        @foreach (var row in Rows)
        {
            <div class="grid grid-cols-[minmax(6rem,9rem)_1fr] items-center gap-3 text-sm" data-testid="sla-row" data-priority="@row.Priority">
                <span class="text-ink-700">
                    @N(PriorityNames.Name(row.Priority))
                    <span class="block text-xs text-ink-500">SLA @N(PriorityNames.SlaText(row.Priority)) · @TicketCount(row.Count)</span>
                </span>
                <span class="relative h-6" aria-hidden="true">
                    @foreach (var tick in Ticks)
                    {
                        <span class="absolute inset-y-0 w-px @(tick == 1 ? "bg-ink-700" : "bg-ink-100")" style="left: @Pos(tick)"></span>
                    }
                    @if (row.P90 is { } p90)
                    {
                        <span class="absolute top-0.5 bottom-0.5 left-0 rounded-r" style="width: @Pos(p90); background-color: @ChartColors.P90"></span>
                    }
                    @if (row.Median is { } median)
                    {
                        <span class="absolute top-2 bottom-2 left-0 rounded-r" style="width: @Pos(median); background-color: @ChartColors.Median"></span>
                    }
                    @if (Math.Max(row.Median ?? 0, row.P90 ?? 0) > Max)
                    {
                        <span class="absolute -right-1 top-1/2 -translate-y-1/2 translate-x-full text-xs font-semibold text-ink-700" title="@T("Poza skalą", "Off the scale")">›</span>
                    }
                </span>
                <span class="col-start-2 -mt-2 text-xs text-ink-600" data-testid="sla-text">
                    @if (row.Median is { } m)
                    {
                        <span>@T("mediana", "median") <strong class="text-ink-900">@Duration(row.MedianTime)</strong> (@Percent(m) SLA)</span>
                        @if (row.P90 is { } p)
                        {
                            <span> · @T("90 % zgłoszeń w", "90 % of tickets within") @Percent(p) SLA</span>
                        }
                    }
                    else
                    {
                        <span>@T("brak zrealizowanych", "none resolved")</span>
                    }
                </span>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SlaUse> Rows { get; set; } = [];

    /// <summary>At least 125 %, so the 100 % line has room on both sides; values past 300 % run to the end.</summary>
    private double Max
    {
        get
        {
            var top = Rows.SelectMany(r => new[] { r.Median ?? 0, r.P90 ?? 0 }).DefaultIfEmpty(0).Max();
            return Math.Clamp(Math.Ceiling(top * 4) / 4, 1.25, 3);
        }
    }

    private IEnumerable<double> Ticks =>
        Enumerable.Range(0, (int)(Max / 0.5) + 1).Select(i => i * 0.5).Where(t => t <= Max);

    private string Pos(double share) =>
        (Math.Min(share, Max) / Max * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";

    /// <summary>"1 zgłoszenie", "5 zgłoszeń"; "1 ticket", "5 tickets".</summary>
    private static string TicketCount(int n) => T(Tickets(n), $"{N(n)} {(n == 1 ? "ticket" : "tickets")}");

    private static string Duration(TimeSpan? time) =>
        time is not { } t ? "-" : t < TimeSpan.FromMinutes(1) ? "< 1 min" : TimeLeft.Duration(t);
}
