@* Columns per bucket with stacked parts (spec 009): thin columns, a 2 px gap between parts, the top rounded. The
   tooltip shows every part and the total. *@
@using Halcyon.Domain.Time
@using static Halcyon.App.Components.Ui.Charts.ChartScale

<svg viewBox="0 0 @W @H" class="h-auto w-full overflow-visible" role="img" aria-label="@Label" data-testid="@TestId">
    @foreach (var tick in Ticks)
    {
        var y = Y(tick);
        <line x1="@ML" x2="@(W - MR)" y1="@F(y)" y2="@F(y)" stroke="@(tick == 0 ? ChartColors.Axis : ChartColors.Grid)" stroke-width="1" />
        <g><text x="@(ML - 8)" y="@F(y + 4)" text-anchor="end" class="chart-axis">@N(tick)</text></g>
    }
    @for (var i = 0; i < Count; i++)
    {
        if (ShowLabel(i, Count))
        {
            <g><text x="@F(Center(i))" y="@(H - 6)" text-anchor="middle" class="chart-axis">@Buckets[i].Label</text></g>
        }
    }

    @for (var i = 0; i < Count; i++)
    {
        var bottom = Y(0);
        var parts = Series.Where(s => s.Values[i] > 0).ToList();
        var x = Center(i) - BarWidth / 2;
        for (var p = 0; p < parts.Count; p++)
        {
            var height = parts[p].Values[i] / (double)Scale.Max * PlotHeight;
            var top = bottom - height;
            var drawnTop = p < parts.Count - 1 ? Math.Min(top + Gap, bottom - 0.5) : top;
            if (p == parts.Count - 1)
            {
                <path d="@RoundedTop(x, drawnTop, BarWidth, bottom)" fill="@parts[p].Color" />
            }
            else
            {
                <rect x="@F(x)" y="@F(drawnTop)" width="@F(BarWidth)" height="@F(bottom - drawnTop)" fill="@parts[p].Color" />
            }
            bottom = top;
        }
    }

    @for (var i = 0; i < Count; i++)
    {
        var index = i;
        var total = Series.Sum(s => s.Values[index]);
        var lines = Series.Select(s => $"{s.Name}: {N(s.Values[index])}").Append($"Razem: {N(total)}").ToList();
        var tipWidth = Math.Max(TextWidth(Buckets[index].LongLabel), lines.Max(TextWidth) + 14) + 20;
        var tipHeight = 26 + 18 * lines.Count;
        var tipX = Center(index) > W / 2.0 ? Center(index) - Band / 2 - 6 - tipWidth : Center(index) + Band / 2 + 6;
        <g class="chart-hover" tabindex="0" data-testid="@($"{TestId}-bucket")">
            <rect class="chart-band" x="@F(ML + Band * index)" y="@MT" width="@F(Band)" height="@F(PlotHeight)" />
            <g class="chart-tip">
                <rect x="@F(tipX)" y="@MT" width="@F(tipWidth)" height="@tipHeight" rx="6" fill="@ChartColors.Surface" stroke="@ChartColors.Axis" />
                <g><text x="@F(tipX + 10)" y="@(MT + 18)" class="chart-tip-title">@Buckets[index].LongLabel</text></g>
                @for (var s = 0; s < lines.Count; s++)
                {
                    var rowY = MT + 18 + 18 * (s + 1);
                    if (s < Series.Count)
                    {
                        <rect x="@F(tipX + 10)" y="@(rowY - 9)" width="10" height="10" rx="2" fill="@Series[s].Color" />
                    }
                    <g><text x="@F(tipX + 26)" y="@rowY" class="@(s < Series.Count ? "chart-tip-text" : "chart-tip-title")">@lines[s]</text></g>
                }
            </g>
        </g>
    }
</svg>

@code {
    private const int H = 230;
    private const int ML = 40;
    private const int MR = 12;
    private const int MT = 10;
    private const int MB = 26;
    private const double Gap = 2;

    [Parameter, EditorRequired] public IReadOnlyList<ChartBucket> Buckets { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ChartSeries> Series { get; set; } = [];
    [Parameter] public string Label { get; set; } = "";

    /// <summary>The width of the drawing in px of text: about the card's width, so 12 px text stays about 12 px.</summary>
    [Parameter] public int W { get; set; } = 520;
    [Parameter] public string TestId { get; set; } = "column-chart";

    private int Count => Buckets.Count;
    private double PlotWidth => W - ML - MR;
    private double PlotHeight => H - MT - MB;
    private double Band => PlotWidth / Count;
    private double BarWidth => Math.Min(24, Band * 0.62);

    private (int Max, int Step) Scale =>
        Nice(Enumerable.Range(0, Count).Select(i => Series.Sum(s => s.Values[i])).DefaultIfEmpty(0).Max());

    private IEnumerable<int> Ticks => Enumerable.Range(0, Scale.Max / Scale.Step + 1).Select(i => i * Scale.Step);

    private double Center(int i) => ML + Band * (i + 0.5);
    private double Y(double value) => MT + PlotHeight - value / Scale.Max * PlotHeight;
}
