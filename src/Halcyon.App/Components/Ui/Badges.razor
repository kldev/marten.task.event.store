@* Priority and status badges in one component: Kind = "priority" | "status". *@
@if (Priority is { } priority)
{
    <span class="badge @PriorityClass(priority)" data-testid="priority">@N(PriorityNames.Name(priority))</span>
}
@if (Status is { } status)
{
    <span class="badge @StatusClass(status)" data-testid="status">@N(PriorityNames.Status(status))</span>
}

@code {
    [Parameter]
    public Priority? Priority { get; set; }

    [Parameter]
    public TicketStatus? Status { get; set; }

    private static string PriorityClass(Priority p) =>
        p switch
        {
            Domain.Tickets.Priority.Critical => "bg-red-100 text-red-900 ring-1 ring-red-200",
            Domain.Tickets.Priority.High => "bg-rufous-400/15 text-rufous-600 ring-1 ring-rufous-400/40",
            Domain.Tickets.Priority.Medium => "bg-halcyon-50 text-halcyon-800 ring-1 ring-halcyon-200",
            _ => "bg-ink-100 text-ink-700 ring-1 ring-ink-200",
        };

    private static string StatusClass(TicketStatus s) =>
        s switch
        {
            TicketStatus.InPool => "bg-ink-100 text-ink-700",
            TicketStatus.InProgress => "bg-halcyon-100 text-halcyon-800",
            _ => "bg-emerald-50 text-emerald-800",
        };
}
