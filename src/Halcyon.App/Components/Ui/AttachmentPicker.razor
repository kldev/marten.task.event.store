@* Drop or pick files; each is checked by the domain's rules and read at once (Blazor's picker forgets earlier files
   when the user picks again). Images get a small preview. *@
@using Halcyon.App.Features.Tickets

<div class="space-y-3" data-testid="attachments-picker">
    <label class="relative flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border-2 border-dashed px-4 py-5 text-center transition @(dragging ? "border-halcyon-500 bg-halcyon-50" : "border-ink-200 bg-ink-50/50 hover:border-halcyon-400 hover:bg-halcyon-50/50")"
           @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false">
        <span class="flex size-10 items-center justify-center rounded-full bg-white text-halcyon-700 shadow-sm">
            <Icon Name="upload" Class="size-5" />
        </span>
        <span class="text-sm font-medium text-ink-800">
            @(reading ? "Wczytywanie…" : "Przeciągnij pliki tutaj albo kliknij, żeby wybrać")
        </span>
        <span class="text-xs text-ink-500">@Hint · do @AttachmentRules.SizeText(AttachmentRules.MaxBytes) na plik, najwyżej @Room</span>
        <InputFile OnChange="OnPickedAsync" multiple accept="@AttachmentRules.Accept" disabled="@(reading || Room == 0)"
                   class="absolute inset-0 cursor-pointer opacity-0" data-testid="attachments-input" />
    </label>

    @foreach (var message in errors)
    {
        <p class="flex items-start gap-1.5 text-xs text-red-700" data-testid="attachments-error"><Icon Name="alarm" Class="mt-px size-3.5 shrink-0" /> @message</p>
    }

    @if (Files.Count > 0)
    {
        <ul class="grid gap-2 sm:grid-cols-2" data-testid="attachments-pending">
            @foreach (var file in Files)
            {
                var type = AttachmentRules.ContentTypeFor(file.Name) ?? "";
                <li class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-2 pr-1" data-testid="attachment-pending">
                    @if (previews.TryGetValue(file, out var preview))
                    {
                        <img src="@preview" alt="" class="size-10 shrink-0 rounded-md object-cover ring-1 ring-ink-200" />
                    }
                    else
                    {
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-ink-100 text-ink-600">
                            <Icon Name="@FileIcon(type)" Class="size-5" />
                        </span>
                    }
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium text-ink-800" title="@file.Name">@file.Name</span>
                        <span class="block text-xs text-ink-500">@AttachmentRules.SizeText(file.Content.Length)</span>
                    </span>
                    <button type="button" class="btn btn-ghost btn-sm" title="Usuń" aria-label="Usuń @file.Name"
                            data-testid="attachment-remove" @onclick="() => RemoveAsync(file)">
                        <Icon Name="x" />
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>Picked so far; the parent owns the list and clears it after sending.</summary>
    [Parameter, EditorRequired]
    public List<PendingFile> Files { get; set; } = [];

    [Parameter]
    public EventCallback FilesChanged { get; set; }

    /// <summary>Already on the ticket - they count against the limit.</summary>
    [Parameter]
    public int Existing { get; set; }

    [Parameter]
    public string Hint { get; set; } = "Zrzuty ekranu, dokumenty, materiały";

    private const long PreviewMaxBytes = 2 * 1024 * 1024;

    private readonly List<string> errors = [];
    private readonly Dictionary<PendingFile, string> previews = [];
    private bool reading;
    private bool dragging;

    private int Room => Math.Max(0, AttachmentRules.MaxPerTicket - Existing - Files.Count);

    public static string FileIcon(string contentType) =>
        contentType switch
        {
            _ when AttachmentRules.IsImage(contentType) => "image",
            _ when contentType.StartsWith("video/", StringComparison.Ordinal) => "file-video",
            "application/zip" => "file-archive",
            _ when contentType.Contains("spreadsheet", StringComparison.Ordinal) || contentType == "text/csv" => "file-spreadsheet",
            _ => "file-text",
        };

    private async Task OnPickedAsync(InputFileChangeEventArgs e)
    {
        errors.Clear();
        reading = true;
        try
        {
            foreach (var picked in e.GetMultipleFiles(AttachmentRules.MaxPerTicket + 1))
            {
                if (Room == 0)
                {
                    errors.Add($"Pominięto „{picked.Name}” - limit to {AttachmentRules.MaxPerTicket} załączników na zgłoszenie.");
                    continue;
                }
                try
                {
                    var (name, type) = AttachmentRules.Check(picked.Name, picked.Size);
                    using var buffer = new MemoryStream();
                    await using (var stream = picked.OpenReadStream(AttachmentRules.MaxBytes))
                        await stream.CopyToAsync(buffer);
                    var file = new PendingFile(name, buffer.ToArray());
                    Files.Add(file);
                    if (AttachmentRules.IsImage(type) && file.Content.Length <= PreviewMaxBytes)
                        previews[file] = $"data:{type};base64,{Convert.ToBase64String(file.Content)}";
                }
                catch (DomainException exception)
                {
                    errors.Add(exception.Message);
                }
            }
        }
        finally
        {
            reading = false;
        }
        await FilesChanged.InvokeAsync();
    }

    private async Task RemoveAsync(PendingFile file)
    {
        Files.Remove(file);
        previews.Remove(file);
        await FilesChanged.InvokeAsync();
    }

    /// <summary>After the parent sent the files.</summary>
    public void Reset()
    {
        errors.Clear();
        previews.Clear();
    }
}
