@page "/blad"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout

<PageTitle>@T("Błąd", "Error") · Halcyon</PageTitle>

<div class="card mt-10 h-fit w-full max-w-md p-8 text-center">
    <h1>@T("Coś poszło nie tak", "Something went wrong")</h1>
    <p class="mt-2 text-sm text-ink-600">@T("Spróbuj ponownie za chwilę. Jeśli problem wraca, zgłoś go do IT.", "Try again in a moment. If the problem keeps coming back, report it to IT.")</p>
    <a href="" class="mt-3 inline-block text-sm text-halcyon-700 hover:underline">@T("Wróć na start", "Back to start")</a>
</div>
