@page "/logowanie"
@layout PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject Microsoft.Extensions.Options.IOptions<Auth.AuthOptions> Auth

<PageTitle>@T("Logowanie", "Sign in") · Halcyon</PageTitle>

<div class="mt-10 w-full max-w-sm space-y-6">
    <div class="card space-y-5 p-6">
        <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
                <h1>@T("Logowanie agenta", "Agent sign-in")</h1>
                <p class="text-sm text-ink-500">@T("Firmowy e-mail i hasło zespołu.", "Your work e-mail and the team password.")</p>
            </div>
            <LanguageSwitch />
        </div>

        @if (Error == "invalid")
        {
            <Notice Message="@T("Nieprawidłowy e-mail lub hasło.", "Wrong e-mail or password.")" />
        }
        else if (Error == "limit")
        {
            <Notice Message="@T("Zbyt wiele prób logowania. Spróbuj ponownie za minutę.", "Too many sign-in attempts. Try again in a minute.")" />
        }

        @* A plain form: /auth/login checks the password, writes the session cookie and redirects (ADR-0005). *@
        <form method="post" action="auth/login" class="space-y-4" data-enhance="false" data-testid="signin-form">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div>
                <label for="email" class="label">E-mail</label>
                <input id="email" name="email" type="email" autocomplete="username" required class="input"
                       placeholder="@N("imie.nazwisko@company.io")" data-testid="signin-email" />
            </div>
            <div>
                <label for="password" class="label">@T("Hasło", "Password")</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required class="input"
                       data-testid="signin-password" />
            </div>
            <button type="submit" class="btn btn-primary w-full" data-testid="signin-submit">@T("Zaloguj", "Sign in")</button>
        </form>

        @if (Auth.Value.HasDefaultAgent)
        {
            @* Demo shortcut (Auth:DefaultAgentEmail): one click, nothing to type. *@
            <form method="post" action="auth/login-default" data-enhance="false" data-testid="signin-default-form">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <button type="submit" class="btn btn-secondary w-full" data-testid="signin-default">
                    @T("Zaloguj się jako domyślny agent", "Sign in as the default agent")
                </button>
                <p class="mt-2 text-center text-xs text-ink-500">@Auth.Value.DefaultAgentEmail</p>
            </form>
        }
    </div>

    <a href="zglos" class="block text-center text-sm text-halcyon-100 hover:text-white" data-testid="public-report-link">
        @T("Nie jesteś agentem? Zgłoś sprawę bez logowania →", "Not an agent? Report an issue without signing in →")
    </a>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
