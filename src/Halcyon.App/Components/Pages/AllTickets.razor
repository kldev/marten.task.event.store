@page "/wszystkie"

<PageTitle>@T("Wszystkie zgłoszenia", "All tickets") · Halcyon</PageTitle>

<div class="space-y-5">
    <div>
        <h1>@T("Wszystkie zgłoszenia", "All tickets")</h1>
        <p class="mt-1 text-sm text-ink-500">@T("Otwarte według terminu, potem zrealizowane.", "Open tickets by deadline, then the resolved ones.")</p>
    </div>
    <TicketListView Scope="TicketScope.All" InitialDeadline="InitialDeadline" />
</div>

@code {
    /// <summary>From the header counters: ?termin=po-terminie | konczy-sie.</summary>
    [SupplyParameterFromQuery(Name = "termin")]
    public string? Termin { get; set; }

    private DeadlineFilter InitialDeadline =>
        Termin switch
        {
            "po-terminie" => DeadlineFilter.Overdue,
            "konczy-sie" => DeadlineFilter.DueSoon,
            _ => DeadlineFilter.Any,
        };
}
