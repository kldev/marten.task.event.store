@page "/system/status"
@using System.Diagnostics
@using Halcyon.App.Infrastructure
@using Microsoft.Extensions.Diagnostics.HealthChecks
@using Microsoft.Extensions.Options
@using static Halcyon.App.Monitoring.SystemText
@inject MonitoringQueries Queries
@inject HealthCheckService Health
@inject IOptions<MonitoringOptions> Options
@inject TimeProvider Time

<PageTitle>@T("Status systemu", "System status") · Halcyon</PageTitle>

<div class="space-y-5" data-testid="system-status-page">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="text-xs text-ink-500">System /</p>
            <h1>@T("Status systemu", "System status")</h1>
            <p class="mt-1 text-sm text-ink-500">
                @T("Odpowiedzi HTTP aplikacji: sukcesy i błędy. Każda odpowiedź trafia do bazy i zostaje tam", "The application's HTTP responses: successes and errors. Every response is stored in the database and kept there for")
                @RetentionText, @T("potem usuwa ją zadanie w tle (zob.", "then a background job deletes it (see") <a href="system/kolejki" class="text-halcyon-700 hover:underline">@T("Kolejki", "Queues")</a>).
            </p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" data-testid="refresh" @onclick="LoadAsync"><Icon Name="refresh" /> @T("Odśwież", "Refresh")</button>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" data-testid="health">
        <div class="card p-4">
            <p class="text-xs font-medium text-ink-500">@T("Wersja", "Version")</p>
            <p class="mt-1 font-mono text-sm text-ink-900">@AppVersion.Text</p>
            <p class="text-xs text-ink-500">@T("działa od", "running for") @Span(Time.GetUtcNow() - started)</p>
        </div>
        @foreach (var (name, entry) in health)
        {
            var ok = entry.Status == HealthStatus.Healthy;
            <div class="card p-4" data-testid="health-@name">
                <p class="text-xs font-medium text-ink-500">@(name switch { "database" => T("Baza danych", "Database"), "storage" => T("Magazyn plików (S3)", "File storage (S3)"), _ => name })</p>
                <p class="mt-1 flex items-center gap-2 text-sm font-semibold @(ok ? "text-emerald-700" : "text-red-700")">
                    <span class="size-2 rounded-full @(ok ? "bg-emerald-500" : "bg-red-600")"></span>
                    @(ok ? T("Działa", "Running") : entry.Status == HealthStatus.Degraded ? T("Częściowo", "Degraded") : T("Nie działa", "Down"))
                </p>
                <p class="text-xs text-ink-500">@(entry.Description ?? $"{entry.Duration.TotalMilliseconds:0} ms")</p>
            </div>
        }
    </div>

    <div class="flex flex-wrap items-end gap-3">
        <div>
            <span class="label text-xs" id="status-range-label">@T("Okres", "Period")</span>
            <div class="inline-flex rounded-lg border border-ink-200 bg-white p-0.5" role="radiogroup" aria-labelledby="status-range-label" data-testid="status-range">
                @foreach (var (value, text, testId) in Ranges)
                {
                    var chosen = range == value;
                    <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")"
                            class="rounded-md px-3 py-1 text-sm transition @(chosen ? "bg-halcyon-700 font-medium text-white shadow-sm" : "text-ink-600 hover:bg-ink-50")"
                            data-testid="status-range-@testId" @onclick="() => ChangeRangeAsync(value)">
                        @text
                    </button>
                }
            </div>
        </div>
        @if (stats is not null)
        {
            <p class="pb-2 text-sm text-ink-500 sm:ml-auto">@T("od", "since") @SystemText.Time(stats.From)</p>
        }
    </div>

    <Notice Message="@error" />

    @if (stats is null)
    {
        <p class="text-sm text-ink-500">@T("Wczytywanie…", "Loading…")</p>
    }
    else
    {
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4 xl:grid-cols-7" data-testid="http-figures">
            <Tile TestId="kpi-total" Label="@T("Wszystkie", "All")" Value="@N(stats.Total)" Note="@($"{T("śr.", "avg")} {Ms(stats.AverageMs)} · p95 {Ms(stats.P95Ms)}")" />
            <Tile TestId="kpi-200" Label="200 OK" Value="@N(stats.Ok)" Note="@($"{T("2xx razem", "2xx total")}: {N(stats.Success)}")" Tone="ok" />
            <Tile TestId="kpi-3xx" Label="@T("Przekierowania 3xx", "3xx redirects")" Value="@N(stats.Redirects)" Note="@Share(stats.Redirects, stats.Total)" />
            <Tile TestId="kpi-403" Label="@T("403 Brak dostępu", "403 Forbidden")" Value="@N(stats.Forbidden)" Note="@Share(stats.Forbidden, stats.Total)" Tone="@(stats.Forbidden > 0 ? "warn" : "")" />
            <Tile TestId="kpi-404" Label="@T("404 Nie znaleziono", "404 Not found")" Value="@N(stats.NotFound)" Note="@($"{T("inne 4xx", "other 4xx")}: {N(stats.OtherClientErrors)}")" Tone="@(stats.NotFound > 0 ? "warn" : "")" />
            <Tile TestId="kpi-500" Label="@T("500 Błąd serwera", "500 Server error")" Value="@N(stats.InternalServerErrors)" Note="@($"{T("5xx razem", "5xx total")}: {N(stats.ServerErrors)} · {Share(stats.ServerErrors, stats.Total)}")" Tone="@(stats.ServerErrors > 0 ? "error" : "")" />
            <Tile TestId="kpi-log" Label="@T("Błędy w logu", "Errors in the log")" Value="@N(logErrors)" Note="@($"{T("ostrzeżenia", "warnings")}: {N(logWarnings)}")" Tone="@(logErrors > 0 ? "error" : "")" Href="system/logi" />
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
            <ChartCard Title="@T("Odpowiedzi w czasie", "Responses over time")" Class="lg:col-span-2" TestId="chart-http"
                       Subtitle="@(range == StatusRange.Hours24 ? T("Na godzinę, czas polski.", "Per hour, Polish time.") : T("Na dzień, czas polski.", "Per day, Polish time."))"
                       Legend="Legend">
                <ChildContent>
                    <StackedColumns Buckets="ChartBuckets" Series="Series" TestId="http-chart" Label="@T("Odpowiedzi HTTP: sukcesy, błędy klienta i serwera", "HTTP responses: successes, client and server errors")" />
                </ChildContent>
                <Table>
                    <ChartTable Headers="TableHeaders" Rows="TableRows" />
                </Table>
            </ChartCard>

            <section class="card p-4 sm:p-5" data-testid="by-status">
                <h2 class="text-base">@T("Według kodu", "By status code")</h2>
                <p class="mt-0.5 text-xs text-ink-500">@T("Każdy kod odpowiedzi w okresie.", "Every response status code in the period.")</p>
                @if (stats.ByStatus.Count == 0)
                {
                    <p class="mt-4 text-sm text-ink-500">@T("Brak odpowiedzi w okresie.", "No responses in the period.")</p>
                }
                else
                {
                    <table class="mt-3 w-full text-sm">
                        <tbody class="divide-y divide-ink-100">
                            @foreach (var s in stats.ByStatus)
                            {
                                <tr data-testid="status-row" data-status="@s.Status">
                                    <td class="py-1.5"><span class="badge font-mono @StatusClass(s.Status)">@s.Status</span></td>
                                    <td class="py-1.5 text-right tabular-nums">@N(s.Count)</td>
                                    <td class="py-1.5 text-right text-xs text-ink-500 tabular-nums">@Share(s.Count, stats.Total)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <section class="card overflow-hidden" data-testid="failing-paths">
            <div class="px-4 pt-4 sm:px-5">
                <h2 class="text-base">@T("Najczęstsze błędy", "Most frequent errors")</h2>
                <p class="mt-0.5 text-xs text-ink-500">@T("Adresy, które w okresie odpowiedziały kodem 400 lub wyższym.", "Paths that answered with status 400 or higher in the period.")</p>
            </div>
            @if (stats.FailingPaths.Count == 0)
            {
                <p class="px-4 py-4 text-sm text-ink-500 sm:px-5" data-testid="no-failures">@T("Brak błędów w okresie.", "No errors in the period.")</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="mt-2 min-w-full divide-y divide-ink-100">
                        <thead><tr><th class="table-head">@T("Kod", "Status")</th><th class="table-head">@T("Adres", "Path")</th><th class="table-head text-right">@T("Liczba", "Count")</th><th class="table-head">@T("Ostatnio", "Last seen")</th></tr></thead>
                        <tbody class="divide-y divide-ink-100">
                            @foreach (var f in stats.FailingPaths)
                            {
                                <tr data-testid="failing-path">
                                    <td class="cell"><span class="badge font-mono @StatusClass(f.Status)">@f.Status</span></td>
                                    <td class="cell font-mono text-xs break-all"><span class="text-ink-500">@f.Method</span> @f.Path</td>
                                    <td class="cell text-right tabular-nums">@N(f.Count)</td>
                                    <td class="cell text-xs whitespace-nowrap text-ink-600">@SystemText.Time(f.LastAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="card overflow-hidden" data-testid="requests">
        <div class="flex flex-wrap items-end gap-3 px-4 pt-4 sm:px-5">
            <div class="mr-auto">
                <h2 class="text-base">@T("Odpowiedzi HTTP", "HTTP responses")</h2>
                <p class="mt-0.5 text-xs text-ink-500">@T("Najnowsze pierwsze. Adres bez parametrów zapytania.", "Newest first. Path without query parameters.")</p>
            </div>
            <div>
                <label class="label text-xs" for="r-outcome">@T("Wynik", "Outcome")</label>
                <select id="r-outcome" class="input py-1.5" data-testid="filter-outcome" value="@filter.Outcome"
                        @onchange="e => ApplyAsync(filter with { Outcome = Enum.Parse<RequestOutcome>(e.Value!.ToString()!), Page = 0 })">
                    <option value="@RequestOutcome.All">@T("Wszystkie", "All")</option>
                    <option value="@RequestOutcome.Success">@T("Sukcesy (< 400)", "Successes (< 400)")</option>
                    <option value="@RequestOutcome.ClientError">@T("Błędy klienta (4xx)", "Client errors (4xx)")</option>
                    <option value="@RequestOutcome.Forbidden">403</option>
                    <option value="@RequestOutcome.NotFound">404</option>
                    <option value="@RequestOutcome.ServerError">@T("Błędy serwera (5xx)", "Server errors (5xx)")</option>
                </select>
            </div>
            <div>
                <label class="label text-xs" for="r-path">@T("Adres zawiera", "Path contains")</label>
                <input id="r-path" class="input py-1.5" placeholder="@T("np. /zgloszenia", "e.g. /zgloszenia")" data-testid="filter-path" value="@filter.Path"
                       @onchange="e => ApplyAsync(filter with { Path = e.Value?.ToString(), Page = 0 })" />
            </div>
        </div>
        @if (requests is not null)
        {
            @if (requests.Rows.Count == 0)
            {
                <p class="px-4 py-4 text-sm text-ink-500 sm:px-5" data-testid="requests-empty">@T("Brak odpowiedzi.", "No responses.")</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="mt-3 min-w-full divide-y divide-ink-100">
                        <thead><tr><th class="table-head">@T("Czas", "Time")</th><th class="table-head">@T("Kod", "Status")</th><th class="table-head">@T("Adres", "Path")</th><th class="table-head text-right">@T("Czas odp.", "Duration")</th><th class="table-head">Agent</th></tr></thead>
                        <tbody class="divide-y divide-ink-100">
                            @foreach (var r in requests.Rows)
                            {
                                <tr data-testid="request-row" data-status="@r.Status">
                                    <td class="cell text-xs whitespace-nowrap text-ink-600">@SystemText.Time(r.At)</td>
                                    <td class="cell"><span class="badge font-mono @StatusClass(r.Status)">@r.Status</span></td>
                                    <td class="cell font-mono text-xs break-all"><span class="text-ink-500">@r.Method</span> @r.Path</td>
                                    <td class="cell text-right text-xs tabular-nums">@Ms(r.ElapsedMs)</td>
                                    <td class="cell text-xs text-ink-600">@(r.Agent ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <Pager Page="filter.Page" HasMore="requests.HasMore" Changed="p => ApplyAsync(filter with { Page = p })" />
        }
    </section>

    <section class="card p-4 sm:p-5" data-testid="monitoring-settings">
        <h2 class="text-base">@T("Ustawienia", "Settings")</h2>
        <p class="mt-0.5 text-xs text-ink-500">@T("Z tymi wartościami działa aplikacja. Ustawia je administrator wdrożenia w zmiennych środowiskowych.", "The values the application runs with. The deployment's administrator sets them in environment variables.")</p>
        <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
            @foreach (var (label, value, variable) in Settings)
            {
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 border-b border-ink-100 py-1">
                    <dt class="text-ink-600">@label <span class="font-mono text-[11px] text-ink-400">@variable</span></dt>
                    <dd class="font-medium text-ink-900">@value</dd>
                </div>
            }
        </dl>
    </section>
</div>

@code {
    private static (StatusRange Value, string Text, string TestId)[] Ranges =>
    [
        (StatusRange.Hours24, T("24 godziny", "24 hours"), "24h"),
        (StatusRange.Days7, T("7 dni", "7 days"), "7d"),
        (StatusRange.Days14, T("14 dni", "14 days"), "14d"),
    ];

    private static IReadOnlyList<LegendItem> Legend =>
    [
        new(T("Sukces (< 400)", "Success (< 400)"), ChartColors.Reported),
        new(T("Błąd klienta (4xx)", "Client error (4xx)"), ChartColors.DueSoon),
        new(T("Błąd serwera (5xx)", "Server error (5xx)"), ChartColors.Late),
    ];

    private static IReadOnlyList<string> TableHeaders => [T("Okres", "Period"), T("Sukces", "Success"), "4xx", "5xx"];

    private readonly DateTimeOffset started = Process.GetCurrentProcess().StartTime.ToUniversalTime();
    private StatusRange range = StatusRange.Hours24;
    private RequestFilter filter = new();
    private HttpStatistics? stats;
    private Slice<RequestRow>? requests;
    private IReadOnlyList<(string Name, HealthReportEntry Entry)> health = [];
    private long logErrors;
    private long logWarnings;
    private string? error;

    private string RetentionText => $"{Options.Value.Retention.TotalDays:0.##} {T("dni", Options.Value.Retention == TimeSpan.FromDays(1) ? "day" : "days")}";

    private IReadOnlyList<(string Label, string Value, string Variable)> Settings =>
    [
        (T("Retencja", "Retention"), RetentionText, "Monitoring__Retention"),
        (T("Sprzątanie co", "Cleanup every"), Span(Options.Value.CleanupInterval), "Monitoring__CleanupInterval"),
        (T("Zapis do bazy co", "Written to the database every"), Span(Options.Value.FlushInterval), "Monitoring__FlushInterval"),
        (T("Pojemność kolejki", "Queue capacity"), N(Options.Value.QueueCapacity), "Monitoring__QueueCapacity"),
        (T("Najniższy poziom logu w bazie", "Lowest log level stored in the database"), Options.Value.LogLevel.ToString(), "Monitoring__LogLevel"),
        (T("Pomijane adresy", "Ignored paths"), string.Join(", ", Options.Value.IgnoredPaths), "Monitoring__IgnoredPaths__N"),
    ];

    private IReadOnlyList<ChartBucket> ChartBuckets =>
        stats!.Buckets.Select(b =>
        {
            var day = DateOnly.FromDateTime(LocalTime.ToLocal(b.From).DateTime);
            return new ChartBucket(new DayRange(day, day), b.Label, b.LongLabel);
        }).ToList();

    private IReadOnlyList<ChartSeries> Series =>
    [
        new(T("Sukces", "Success"), ChartColors.Reported, stats!.Buckets.Select(b => b.Success).ToList()),
        new(T("Błąd klienta", "Client error"), ChartColors.DueSoon, stats.Buckets.Select(b => b.ClientErrors).ToList()),
        new(T("Błąd serwera", "Server error"), ChartColors.Late, stats.Buckets.Select(b => b.ServerErrors).ToList()),
    ];

    private IReadOnlyList<IReadOnlyList<string>> TableRows =>
        stats!.Buckets.Select(b => (IReadOnlyList<string>)[b.LongLabel, N(b.Success), N(b.ClientErrors), N(b.ServerErrors)]).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            var report = await Health.CheckHealthAsync(c => c.Tags.Contains(HalcyonApp.ReadyTag));
            health = report.Entries.Select(e => (e.Key, e.Value)).ToList();
            stats = await Queries.StatisticsAsync(range);
            (logErrors, logWarnings) = await Queries.LogCountsAsync(stats.From);
            requests = await Queries.RequestsAsync(filter);
        }
        catch (Npgsql.NpgsqlException e)
        {
            error = $"{T("Nie udało się odczytać statystyk z bazy", "Could not read the statistics from the database")}: {e.Message}";
        }
    }

    private async Task ChangeRangeAsync(StatusRange value)
    {
        range = value;
        await LoadAsync();
    }

    private async Task ApplyAsync(RequestFilter value)
    {
        filter = value;
        requests = await Queries.RequestsAsync(filter);
    }
}
