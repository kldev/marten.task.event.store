@page "/raporty/{Slug}"
@using Halcyon.App.Features.Reports
@using System.Globalization
@inject CategoryReportQueries Reports

<PageTitle>Raport @(report?.Title) · Halcyon</PageTitle>

@if (report is null)
{
    <div class="card p-8 text-center" data-testid="report-missing">
        <h1>Nie ma takiego raportu</h1>
        <a href="raporty" class="mt-3 inline-block text-sm text-halcyon-700 hover:underline">Wróć do raportów</a>
    </div>
}
else
{
    var category = report.Category;
    <div class="space-y-5" data-testid="report-page" data-report="@report.Slug">
        <div>
            <p class="text-xs text-ink-500"><a href="raporty" class="hover:underline">Raporty</a> /</p>
            <h1>Raport: @report.Title</h1>
            <p class="mt-1 text-sm text-ink-500">Zgłoszenia według daty zgłoszenia, z danymi do raportu jako kolumnami (puste kolumny są pomijane).</p>
        </div>

        <div class="flex flex-wrap items-end gap-3" data-testid="report-filters">
            <div>
                <span class="label text-xs">Zgłoszone od</span>
                <DatePicker Id="r-from" TestId="filter-from" Value="@Day(filter.From)" ValueChanged="v => ApplyAsync(filter with { From = Parse(v) })" />
            </div>
            <div>
                <span class="label text-xs">do</span>
                <DatePicker Id="r-to" TestId="filter-to" Value="@Day(filter.To)" ValueChanged="v => ApplyAsync(filter with { To = Parse(v) })" />
            </div>
            @if (category.Groups.Count > 1)
            {
                <div>
                    <label class="label text-xs" for="r-group">Rynek</label>
                    <select id="r-group" class="input py-1.5" data-testid="filter-group" value="@(filter.Group ?? "")"
                            @onchange="e => ApplyAsync(filter with { Group = Empty(e.Value), SubcategoryKey = null })">
                        <option value="">Wszystkie</option>
                        @foreach (var group in category.Groups)
                        {
                            <option value="@group">@group</option>
                        }
                    </select>
                </div>
            }
            <div>
                <label class="label text-xs" for="r-sub">Podkategoria</label>
                <select id="r-sub" class="input py-1.5" data-testid="filter-subcategory" value="@(filter.SubcategoryKey ?? "")"
                        @onchange="e => ApplyAsync(filter with { SubcategoryKey = Empty(e.Value) })">
                    <option value="">Wszystkie</option>
                    @foreach (var sub in category.Subcategories.Where(s => filter.Group is null || s.Group == filter.Group))
                    {
                        <option value="@sub.Key">@(filter.Group is null ? sub.DisplayName : sub.Name)</option>
                    }
                </select>
            </div>
            <CompletionToggle Value="filter.Completion" ValueChanged="v => ApplyAsync(filter with { Completion = v })" />
        </div>

        @if (table is not null)
        {
            <ReportTableView Table="table" ExportUrl="f => ReportExportEndpoints.UrlFor(report, filter, f)" />
        }
    </div>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private CategoryReport? report;
    private ReportFilter filter = new();
    private ReportTable? table;

    protected override async Task OnParametersSetAsync()
    {
        var next = CategoryReport.Find(Slug);
        if (next != report)
        {
            report = next;
            filter = new ReportFilter();
        }
        await LoadAsync();
    }

    private async Task LoadAsync() => table = report is null ? null : await Reports.RunAsync(report, filter);

    private async Task ApplyAsync(ReportFilter next)
    {
        filter = next;
        await LoadAsync();
    }

    private static string? Day(DateOnly? day) => day?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static DateOnly? Parse(string? value) =>
        DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;

    private static string? Empty(object? value) => value?.ToString() is { Length: > 0 } s ? s : null;
}
