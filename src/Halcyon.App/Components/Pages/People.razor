@page "/osoby"
@inject AgentDirectory Directory

<PageTitle>@T("Osoby", "People") · Halcyon</PageTitle>

<div class="space-y-5">
    <div>
        <h1>@T("Osoby zgłaszające", "Requesters")</h1>
        <p class="mt-1 text-sm text-ink-500">@T("Pracownicy, którzy zgłaszają sprawy. Nie logują się - wybierają siebie z listy.", "Employees who report issues. They do not sign in - they pick themselves from the list.")</p>
    </div>

    @if (people is null)
    {
        <p class="text-sm text-ink-500">@T("Wczytywanie…", "Loading…")</p>
    }
    else
    {
        <div class="card overflow-x-auto">
            <table class="min-w-full divide-y divide-ink-100" data-testid="people">
                <thead class="bg-ink-50/60">
                    <tr>
                        <th class="table-head">@T("Imię i nazwisko", "Name")</th>
                        <th class="table-head">@T("Dział", "Department")</th>
                        <th class="table-head">E-mail</th>
                        <th class="table-head">@T("Telefon", "Phone")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    @foreach (var p in people)
                    {
                        <tr data-testid="person-row">
                            <td class="cell font-medium text-ink-900">@p.FullName</td>
                            <td class="cell text-ink-700">@N(p.Department)</td>
                            <td class="cell text-ink-700">@p.Email</td>
                            <td class="cell text-ink-700">@(p.Phone ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<PersonRow>? people;

    protected override async Task OnInitializedAsync() => people = await Directory.PeopleAsync();
}
