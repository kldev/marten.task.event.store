<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Latest stable versions on 2026-11-11 (ADR-0002). -->
    <PackageVersion Include="Marten" Version="9.59.0" />
    <!-- Handlers, the transactional outbox and scheduled messages over Marten (ADR-0016); the versions Ambit runs. -->
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
    <!-- E-mail over SMTP (spec 013). -->
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
    <!-- Report exports (spec 008): XLSX (MIT) and PDF (QuestPDF Community licence, see the README). -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
</Project>
