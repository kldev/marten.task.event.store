<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Level 2a (ADR-0007): the store alone on a real PostgreSQL 18 (Testcontainers) - HalcyonStore's indexes, projections
    and stream locks, with no host, no Wolverine and no migrator. Fast, and a failure points at the store, not a page.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Halcyon.Database/Halcyon.Database.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
